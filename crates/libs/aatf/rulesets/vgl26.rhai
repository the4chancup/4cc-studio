// 4cc Studio AATF ruleset. Open it in the Ruleset editor to change it.
const RULESET = #{
    schema: 1,
    name: "VGL26",
    squad_size: 23,

    stats: #{
        rating: ["dribbling", "goalkeeping", "low_pass", "lofted_pass", "swerve",
                 "catching", "clearing", "reflexes", "coverage", "body_control",
                 "physical_contact", "kicking_power", "explosive_power", "ball_control",
                 "ball_winning", "jump", "place_kicking", "stamina", "speed"],
        at_most: ["attacking_prowess", "defensive_prowess",
                  "weak_foot_usage", "weak_foot_accuracy"],
    },

    tiers: [
        #{ id: "gold", label: "Gold", count: 1,
           when: #{ height_min: 195, height_max: 195 },
           rate: 99, form: 8, injury_resistance: 2,
           stats: #{ place_kicking: 94, ball_winning: 94, defensive_prowess: 60 },
           weak_foot: #{ usage: 4, accuracy: 4 },
           cards: 9, free: #{ tricks: 12, com: 2 }, a_positions: 2 },
        #{ id: "silver", label: "Silver", count: 2,
           when: #{ height_min: 195, height_max: 195 },
           rate: 95, form: 8, injury_resistance: 2,
           stats: #{ attacking_prowess: 99, finishing: 99, heading: 99,
                    place_kicking: 90, ball_winning: 90, defensive_prowess: 60 },
           weak_foot: #{ usage: 4, accuracy: 4 },
           cards: 8, free: #{ tricks: 12, com: 2 }, a_positions: 2 },
        #{ id: "bronze", label: "Bronze", count: 2,
           when: #{ height_min: 190, height_max: 190 },
           rate: 91, form: 8, injury_resistance: 2,
           stats: #{ attacking_prowess: 96, finishing: 96, heading: 96,
                    place_kicking: 86, ball_winning: 86, defensive_prowess: 60 },
           weak_foot: #{ usage: 4, accuracy: 4 },
           cards: 8, free: #{ tricks: 12, com: 2 }, a_positions: 2 },
        #{ id: "buffed", label: "Buffed", count: 8,
           when: #{ height_min: 185, height_max: 185, not: #{ positions: ["GK"] } },
           rate: 85, form: 4, injury_resistance: 1,
           stats: #{ attacking_prowess: 90, aggression: 90, jump: 75,
                    stamina: 70, ball_winning: 65, defensive_prowess: 60 },
           weak_foot: #{ usage: 4, accuracy: 4 },
           cards: 7, free: #{ tricks: 12, com: 1 }, a_positions: 2 },
        #{ id: "goalkeeper", label: "Goalkeeper", counts_as: "regular",
           when: #{ positions: ["GK"] },
           rate: 72, form: 8, injury_resistance: 1,
           weak_foot: #{ usage: 4, accuracy: 4 },
           cards: 5, free: #{ tricks: 12, com: 1 }, a_positions: 1 },
        #{ id: "regular", label: "Regular", count: 10,
           when: #{ height_min: 180, height_max: 180 },
           rate: 80, form: 4, injury_resistance: 1,
           stats: #{ aggression: 90, jump: 80, defensive_prowess: 70, ball_winning: 70,
                    explosive_power: 70, goalkeeping: 72, catching: 72, clearing: 72,
                    reflexes: 72, coverage: 72, stamina: 65 },
           weak_foot: #{ usage: 4, accuracy: 4 },
           cards: 6, free: #{ tricks: 12, com: 1 }, a_positions: 2 },
    ],

    card_groups: #{
        tricks: ["scissors_feint", "double_touch", "flip_flap", "marseille_turn",
                 "sombrero", "crossover_turn", "cut_behind_and_turn", "scotch_move",
                 "step_on_skill", "rabona", "no_look_pass", "malicia"],
    },

    universal: #{
        registered_position_a: true, fielded_at_a: [1],
        no_b_ratings: true, gk_not_second_a: true,
        age: [15, 50], weight: #{ floor: 30, below: 129, above: 81 },
        captain_required: true, min_goalkeepers: 1, max_skill_cards: 41,
    },

    specials: [
        #{ label: "Heading is a free card", then: #{ free_cards: ["heading"] } },
        #{ label: "The captain's Captaincy card and one more are free",
           when: #{ captain: true },
           then: #{ free_cards: ["captaincy"], cards: 1 } },
        #{ label: "Medals cannot be goalkeepers",
           when: #{ tiers: ["gold", "silver", "bronze"], positions: ["GK"] },
           then: #{ forbid: "Medals cannot play as GK" } },
        #{ label: "Goalkeepers are 185",
           when: #{ positions: ["GK"], not: #{ height_min: 185, height_max: 185 } },
           then: #{ forbid: "GKs must be 185cm" } },
    ],

    team_settings: [
        #{ label: "No man marking", man_marking: false },
        #{ label: "Support settings", auto_substitution: false,
           auto_offside_trap: false, auto_preset_change: false },
        #{ label: "No 3-4-3 formations", forbidden_shapes: [[3, 4, 3]] },
    ],

    suggestions: ["cards", "com", "a_positions", "weak_foot", "free_cards"],
};

