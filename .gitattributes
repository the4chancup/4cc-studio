* text=auto eol=lf

# Test fixtures are game files, never text, whatever their extension or contents
crates/**/tests/fixtures/** -text
crates/**/tests/fixtures/**/README.md text

# CRLF by contract: the teams_list crate writes CRLF and a test compares the shipped list with
# its own write byte for byte; as text, a fresh `git add` (the mutants remote snapshot) made it LF
crates/libs/teams_list/data/teams_list.txt -text

# The bundle's launchers: cmd reads a batch file with LF line ends wrongly (a `goto` or `call`
# to a label can miss it), so they are checked out CRLF whatever the platform
resources/bundle/*.bat text eol=crlf

# A game file copied byte for byte from Red's templates (CRLF): packed as it is
resources/templates/dummy.mtl -text

# A game file extracted byte for byte from PES 2017's data CPK: read as it is
resources/templates/uniform.mtl -text

# The pre-Fox referee template tree, copied byte for byte from Red (three `.mtl` files are CRLF)
resources/templates/referees_prefox/** -text

# The icon, images made by scripts/make_icon.py: binary, never normalized
resources/icon/** -text
