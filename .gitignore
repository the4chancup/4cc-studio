# Cargo build output (a moved target dir is the developer's business; the default is here)
/target/

# Session scratch: analysis scripts and probes that are not part of the repository
/.tmp/

# cargo-mutants results (`just mutants`, `just mutants-diff`)
/mutants.out/
/mutants.out.old/

# extra-mutants results (`just extra-mutants`)
/extra_mutants.out/

# Clef scan report and answer cache (`just clef`, `just clef-diff`)
/clef.out/

# Citation audit report and answer cache (`just citation-audit`)
/snap.out/

# OS noise
Thumbs.db
.DS_Store
# ...except a test fixture's, which stands for one: tree copies that honor this file (the mutation
# runs' snapshots) would otherwise drop it and fail the test that reads it
!crates/**/tests/fixtures/**/Thumbs.db
__pycache__/
